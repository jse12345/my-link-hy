rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. links 컬렉션: 누구나 읽기 가능(로그인 불필요), 쓰기는 본인(userId)만 가능
    match /users/{userId}/links/{linkId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. profile: 누구나 읽기 가능, 쓰기는 본인(userId)만 가능 (3차시 명세)
    match /users/{userId}/profile {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. profile 하위 문서 (users/{userId}/profile/{docId}) 지원
    match /users/{userId}/profile/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. users 루트 문서
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. username -> userId 매핑 컬렉션 (/[username] 라우팅용)
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
